<Project Sdk="Microsoft.NET.Sdk">

  <!-- Attribution -->
  <PropertyGroup>
    <Authors>Nate Savage</Authors>
    <Copyright>Nate Savage</Copyright>
    <RootNamespace>Savage.Logs</RootNamespace>
  </PropertyGroup>

  <!-- Dotnet Configuration -->
  <!-- 
       Unity 2018.1 onward targets netstandard 2.0 and C# 7.3  (Mono or ILCPP backend) 
       Unity 2021.2 onward targets netstandard 2.1 and C# 8.0  (Mono or ILCPP backend) 
       Godot 3 targets  .NET framework 4.7.2 and C# 7.3        (Mono backend)
       Godot 4 targets  .NET 6 and C# 10                       (CoreCLR backend, Roslyn compiler)
       Godot 4 supports .NET 8 and C# 12                       (CoreCLR backend, Roslyn compiler)
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- Expose Internals To Testing & Benchmark Projects -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Savage.Logs.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Savage.Logs.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  

  <!-- Nuget Publishing Configuration -->
  <PropertyGroup>
    <Title>Savage Logs</Title>
    <Description> A logging library that lets you change your mind later. </Description>
    <PackageTags> structured logging; log; unity; game engine; godot; games; savage; nate; </PackageTags>
    <Version>2.0.0-beta1</Version>

    <PackageReleaseNotes> Pre-release for library version 2 </PackageReleaseNotes>

    <NeutralLanguage>en</NeutralLanguage>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/NateSavage/Savage.Logs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NateSavage/Savage.Logs</RepositoryUrl>
    <RepositoryCommit></RepositoryCommit>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
